# Copy this file to backend/local.env. The real file is ignored by Git.
PPTIST_CLOUD_HOST=127.0.0.1
PPTIST_CLOUD_PORT=3175
PPTIST_ALLOWED_ORIGIN=http://127.0.0.1:5173

PPTIST_ADMIN_USERNAME=alien
PPTIST_ADMIN_PASSWORD_HASH=scrypt$replace-with-a-real-salt$replace-with-a-real-key
PPTIST_SESSION_DAYS=7

# Use either PPTIST_DATABASE_URL or PPTIST_DATABASE_URL_FILE.
PPTIST_DATABASE_URL=postgresql://pptist:replace-me@127.0.0.1:5432/pptist
PPTIST_DB_POOL_MAX=5

# The local development secret must contain at least 32 characters.
PPTIST_MEDIA_CREDENTIAL_SECRET=replace-with-at-least-32-random-characters
PPTIST_MEDIA_API_BASE=https://media.example.com/api
PPTIST_MEDIA_PUBLIC_BASE=https://media.example.com

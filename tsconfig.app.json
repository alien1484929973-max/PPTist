{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "packages/**/*.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pptist/presentation-core": ["./packages/presentation-core/src/index.ts"],
      "@pptist/presentation-core/*": ["./packages/presentation-core/src/*"]
    }
  }
}

{
  "name": "pptist-presentation-player",
  "version": "0.1.0-beta.2",
  "description": "Framework-independent DOM player for PPTist presentation documents",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/public.d.ts",
    "src/types.ts",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/public.d.ts",
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "node scripts/verify-package.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "prepack": "npm run build && npm run verify"
  },
  "keywords": [
    "pptist",
    "presentation",
    "slides",
    "player",
    "typescript"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alien1484929973-max/PPTist.git",
    "directory": "packages/presentation-player"
  },
  "homepage": "https://github.com/alien1484929973-max/PPTist/tree/master/packages/presentation-player",
  "bugs": "https://github.com/alien1484929973-max/PPTist/issues",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1"
  }
}

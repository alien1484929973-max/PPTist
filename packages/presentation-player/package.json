{
  "name": "@pptist/presentation-player",
  "version": "0.1.0",
  "description": "Framework-independent DOM player for PPTist presentation documents",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/public.d.ts",
    "src/types.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/public.d.ts",
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "pptist",
    "presentation",
    "slides",
    "player",
    "typescript"
  ],
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  }
}
